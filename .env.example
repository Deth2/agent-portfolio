# LLM adapter (ADR-0001, ADR-0003) — all model access goes through this
# OpenAI-compatible config; swap providers without touching code.
#
# Default (production): Groq, an OpenAI-compatible free-tier endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# For local development against Ollama instead (not deployable on Vercel
# serverless, see ADR-0001):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.3

# Question Limit (ADR-0002) — a session-scoped, client-side cost-containment
# measure, not a security boundary. Read at build time (client-side check),
# so both vars must be NEXT_PUBLIC_ to reach the browser bundle.
#
# Defaults to enabled with a threshold of 5 questions per session.
NEXT_PUBLIC_QUESTION_LIMIT_ENABLED=true
NEXT_PUBLIC_QUESTION_LIMIT_THRESHOLD=5
